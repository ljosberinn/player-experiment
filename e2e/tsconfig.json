{
  "compilerOptions": {
    "target": "ES2022",
    // DOM is for the callbacks passed to browser.execute, which run inside the
    // webview rather than in the test process.
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "@wdio/globals/types", "@wdio/mocha-framework", "expect-webdriverio"]
  },
  "include": ["**/*.ts"]
}
