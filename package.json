{
  "name": "apex",
  "private": true,
  "license": "MIT",
  "version": "0.11.1",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "dev": "vite",
    "dev:scan": "tauri dev --config src-tauri/tauri.scan.conf.json",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "e2e": "wdio run e2e/wdio.conf.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bindings": "cargo test --manifest-path src-tauri/Cargo.toml export_bindings",
    "notices": "node scripts/notices.mjs",
    "tauri:parity": "node scripts/tauri-parity.mjs",
    "genres": "node scripts/genres.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-virtual": "^3.14.13",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "d3-scale": "^4.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-scale": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@wdio/cli": "^9.31.9",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "^1.4.0",
    "@wdio/tauri-service": "^1.4.0",
    "jsdom": "^30.0.1",
    "oxc-transform-react": "^0.150.0",
    "react-scan": "^0.5.7",
    "ts-node": "^10.9.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
