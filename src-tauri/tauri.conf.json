{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Player",
  "version": "0.3.0",
  "identifier": "dev.ljosberinn.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Player",
        "width": 1416,
        "height": 864,
        "minWidth": 1032,
        "minHeight": 624,
        "resizable": true,
        "visible": false,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost cover: http://cover.localhost; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ljosberinn/player-experiment/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCRkJBNEIxM0U0NjhCQUMKUldTc2kwWStzYVQ3NjlFcWJMUjRCSWJoVW5kd3JveVhyTS8weUY3bmZMMFhHc3NveDcvYVpqejgK"
    }
  }
}
