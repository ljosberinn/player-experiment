{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Player",
        "width": 1416,
        "height": 864,
        "minWidth": 1032,
        "minHeight": 624,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "wdio",
          "description": "Test-only WebdriverIO instrumentation. Merged in via --config for the e2e build only, so a normal build never grants these permissions.",
          "windows": ["main"],
          "permissions": ["wdio:default"]
        }
      ]
    }
  }
}
