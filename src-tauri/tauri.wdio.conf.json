{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Player",
        "width": 1180,
        "height": 720,
        "minWidth": 860,
        "minHeight": 520,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "wdio",
          "description": "Test-only WebdriverIO instrumentation. Merged in via --config for the e2e build only, so a normal build never grants these permissions.",
          "windows": ["main"],
          "permissions": ["wdio:default"]
        }
      ]
    }
  }
}
